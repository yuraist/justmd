{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "justmd-site",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-01",
  // Run first to redirect legacy hostnames before serving static assets.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "analytics_engine_datasets": [
    { "binding": "DOWNLOADS", "dataset": "justmd_downloads" }
  ],
  // Keep the legacy hostname attached while canonical links use istomin.app.
  "routes": [
    { "pattern": "justmd.istomin.app", "custom_domain": true },
    { "pattern": "justmd.nuta.life", "custom_domain": true }
  ]
}
